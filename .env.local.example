# Local NextAuth URL for this app.
NEXTAUTH_URL=http://localhost:3000
# Leave unset for local root-path development. Docker builds use /nextauth.
# NEXT_PUBLIC_BASE_PATH=/nextauth

# Generate with: openssl rand -hex 32
NEXTAUTH_SECRET=change-me

# OpenIssuer tenant issuer routed through the API gateway.
# Examples:
# OPENISSUER_ISSUER=https://platform.openissuer.com/issuer
# OPENISSUER_ISSUER=https://free.openissuer.com/issuer
# OPENISSUER_ISSUER=https://business1.openissuer.com/issuer
# OPENISSUER_ISSUER=https://business2.openissuer.com/issuer
OPENISSUER_ISSUER=https://free.openissuer.com/issuer

# OAuth client registered in the selected issuer.
OPENISSUER_CLIENT_ID=
OPENISSUER_CLIENT_SECRET=

# Keep this as myauth unless you also update the registered redirect URI.
OPENISSUER_PROVIDER_ID=myauth
OPENISSUER_SCOPES=openid profile email
